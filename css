/* ---------- Colors and fonts ---------- */
:root {
  --cream: #fff8f0;
  --ink: #4a3728;
  --brown: #6b4226;
  --brown-dark: #3b2618;
  --accent: #a8561b;
  --sky: #dcecfa;
  --line: #ead9c6;

  --serif: "Lora", Georgia, serif;
  --sans: "Montserrat", system-ui, sans-serif;
}

/* ---------- Base ---------- */
html {
  scroll-behavior: smooth;
  scroll-padding-top: 4.5rem;
}

body {
  background: var(--cream);
  color: var(--ink);
  font-family: var(--sans);
  line-height: 1.7;
}

h1, h2, h3 {
  font-family: var(--serif);
  color: var(--brown);
}

a { color: var(--accent); }

a:focus-visible,
.btn:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 2px;
}

/* ---------- Navbar and hero ---------- */
.navbar { background: var(--brown-dark); }
.navbar .nav-link { color: #e8d9c8; }
.navbar .nav-link:hover,
.navbar .nav-link.active { color: #fff; }

.hero {
  background: var(--brown-dark);
  color: #f3e7d8;
  padding: 8rem 0 4rem;
}

.hero h1 {
  color: #fff;
  font-size: clamp(2.25rem, 6vw, 3.75rem);
}

.hero .lead { max-width: 40rem; }
.hero a { color: #f3c9a0; }

/* ---------- Sections ---------- */
section {
  padding: 4rem 0;
  border-top: 1px solid var(--line);
}

.intro { max-width: 42rem; margin-bottom: 1.5rem; }

.built-with {
  margin: 1.5rem 0 0;
  font-size: 0.9rem;
  color: var(--brown);
}

/* ---------- Buttons ---------- */
.btn-brown {
  background: var(--accent);
  color: #fff;
  font-weight: 600;
}

.btn-brown:hover { background: #8a4513; color: #fff; }

/* ---------- Responsive photo grid ---------- */
.alert-device {
  background: var(--sky);
  border: 0;
  color: var(--brown-dark);
}

.photo-grid figure { margin: 0; }

.photo-grid img {
  width: 100%;
  height: 11rem;
  object-fit: cover;
  border-radius: 0.5rem;
}

.photo-grid figcaption {
  margin-top: 0.5rem;
  font-size: 0.85rem;
  line-height: 1.4;
}

.photo-grid figcaption strong {
  display: block;
  font-size: 1rem;
}

/* ---------- Corgi scene ---------- */
#corgiScene {
  position: relative;
  width: 100%;
  max-width: 600px;
  height: 400px;
  margin: 1.5rem auto;
  overflow: hidden;
  border: 4px solid #8b5e3c;
  border-radius: 1.25rem;
}

#corgiSleep,
#corgiAwake {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

#corgiSleep { z-index: 2; cursor: pointer; }
#corgiAwake { z-index: 1; opacity: 0; }

#corgiMessage {
  position: absolute;
  top: 1.5rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;
  padding: 0.6rem 1.5rem;
  border-radius: 1.5rem;
  background: #fff;
  color: #333;
  font-weight: 600;
}

/* ---------- Apple tree ---------- */
.panel {
  height: 100%;
  padding: 1.5rem;
  background: var(--sky);
  border-radius: 0.75rem;
}

#tree-illustration {
  display: block;
  width: 100%;
  max-width: 400px;
  margin: auto;
}

#tree-illustration circle[id^="apple"] {
  animation-duration: 1.5s;
}

/* ---------- Footer ---------- */
footer {
  background: var(--brown-dark);
  color: #e8d9c8;
}

footer a { color: #f3c9a0; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .animate__animated { animation: none !important; }
}